generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String  @id @default(cuid())
  email          String  @unique
  name           String?
  hashedPassword String?

  workspaceGroups WorkspaceGroup[]
  workspaces      Workspace[]
  nodes           Node[]
  activityLogs    NodeActivity[]
}

model WorkspaceGroup {
  id         String      @id @default(cuid())
  name       String
  orderIndex Int
  userId     String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaces Workspace[]

  @@index([userId, orderIndex])
}

model Workspace {
  id         String      @id @default(cuid())
  name       String
  groupId    String?
  orderIndex Int
  userId     String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  group        WorkspaceGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes        Node[]
  activityLogs NodeActivity[]

  @@index([userId, orderIndex])
  @@index([groupId])
}

enum NodeStatus {
  not_started
  in_progress
  done
}

enum NodeConfidence {
  weak
  ok
  strong
}

model Node {
  id             String         @id @default(cuid())
  workspaceId    String
  parentId       String?
  title          String
  status         NodeStatus?
  confidence     NodeConfidence?
  notes          String         @default("")
  lastReviewedAt DateTime?
  orderIndex     Int
  userId         String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent       Node?         @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     Node[]        @relation("NodeChildren")
  activityLogs NodeActivity[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, parentId, orderIndex])
  @@index([userId])
}

model NodeActivity {
  id          String   @id @default(cuid())
  nodeId      String
  workspaceId String
  action      String
  timestamp   DateTime @default(now())
  userId      String

  node      Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, timestamp])
  @@index([nodeId])
}
